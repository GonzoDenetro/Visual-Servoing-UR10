<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="wrist_camera"
               params="parent_link xyz rpy sim_gazebo">

    <!-- LINK -->
    <link name="wrist_camera_link">
      <visual>
        <geometry>
          <box size="0.02 0.02 0.02"/>
        </geometry>
      </visual>

      <collision>
        <geometry>
          <box size="0.02 0.02 0.02"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.05"/>
        <inertia ixx="1e-6" ixy="0" ixz="0"
                 iyy="1e-6" iyz="0"
                 izz="1e-6"/>
      </inertial>
    </link>

    <!-- JOINT -->
    <joint name="wrist_camera_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="wrist_camera_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- GAZEBO SENSOR -->
    <xacro:if value="${sim_gazebo}">
      <gazebo reference="wrist_camera_link">

        <sensor type="camera" name="wrist_camera_sensor">
          <update_rate>30</update_rate>

          <camera>
            <horizontal_fov>1.396</horizontal_fov>

            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>

            <clip>
              <near>0.02</near>
              <far>5.0</far>
            </clip>
          </camera>

          <plugin name="camera_plugin"
                  filename="libgazebo_ros_camera.so">

            <ros>
              <namespace>wrist_camera</namespace>
            </ros>

            <frame_name>wrist_camera_link</frame_name>

          </plugin>

        </sensor>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>